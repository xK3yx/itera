# Copy to .env and fill in the values marked "change me".

# App
APP_NAME=Itera
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=itera_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itera_db
# Only used when running the API outside Docker:
DATABASE_URL=postgresql+asyncpg://itera_user:change-me@localhost:5432/itera_db

# LLM: Ollama is tried first, Groq is the fallback.
# Set at least one of them.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
# Groq retires models over time; change this if calls start failing with model_not_found
GROQ_MODEL=openai/gpt-oss-120b

# YouTube Data API v3 (optional; falls back to search links)
YOUTUBE_API_KEY=

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated emails allowed to use the /api/v3/admin endpoints
ADMIN_EMAILS=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost,http://localhost:5173
